{
  "name": "@agent-hub/hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent Hub daemon: runs agents, brokers permissions, orchestrates delegation and serves the LAN API/UI.",
  "main": "dist/index.js",
  "bin": {
    "agent-hub": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx watch src/cli.ts serve",
    "build": "tsup",
    "start": "node dist/cli.js serve",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "^0.99.0",
    "@agentclientprotocol/codex-acp": "^2.5.0",
    "@agentclientprotocol/sdk": "^2.1.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "@lydell/node-pty": "^1.2.0-beta.18",
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@xterm/addon-serialize": "^0.13.0",
    "@xterm/headless": "^5.5.0",
    "cross-spawn": "^7.0.6",
    "fastify": "^5.6.0",
    "node-forge": "^1.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "web-push": "^3.6.7",
    "which": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@agent-hub/shared": "0.1.0",
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^24.0.0",
    "@types/node-forge": "^1.3.14",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/web-push": "^3.6.4",
    "@types/which": "^3.0.4",
    "@types/ws": "^8.18.2",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
